#!/bin/sh /etc/rc.common

# The gl_clients daemon stores MAC addresses of connected clients in a
# SQLite database at /etc/oui-tertf/client.db. On flash this creates a
# persistent log of every device that ever associated to the Mudi — a
# forensic artifact blue-merle is supposed to erase.
#
# We solve this by mounting a tmpfs over /etc/oui-tertf so the database
# lives only in RAM and is wiped on poweroff.
#
# Ordering:
#   * We must run before gl-tertf (60) and gl_clients (99).
#   * We should run early enough that no service has opened the db yet
#     (that is why the package's preinst also stops gl_clients before we
#     take over on first install).
#   * start() additionally stops gl_clients itself if it is already
#     running (a manual `service volatile-client-macs start` on a live
#     system) and restarts it after the mount — an fd held to the
#     hidden flash inode would corrupt the db.

# shellcheck disable=SC2034 # START/STOP are consumed by /etc/rc.common
START=9
# shellcheck disable=SC2034
STOP=99

CLIENT_DB_DIR=/etc/oui-tertf
CLIENT_DB=$CLIENT_DB_DIR/client.db

start() {
    # Idempotent: if we're already mounted, nothing to do.
    # Use /proc/mounts instead of `mountpoint -q` — busybox on stock
    # Mudi firmware does not ship `mountpoint` (util-linux).
    if grep -q " ${CLIENT_DB_DIR} " /proc/mounts; then
        return 0
    fi

    # gl_clients must not hold the db open while we replace the
    # directory: it would keep an fd to the hidden flash inode and
    # corrupt the db (SQLite journal on tmpfs, main db on flash).
    # Mirror the package preinst: stop it first, restart it after.
    gl_clients_was_running=""
    if pidof gl_clients >/dev/null 2>&1; then
        gl_clients_was_running=1
        /etc/init.d/gl_clients stop 2>/dev/null || true
        logger -p notice -t blue-merle "volatile-client-macs: stopped gl_clients to take over $CLIENT_DB_DIR"
    fi

    mkdir -p "$CLIENT_DB_DIR"

    # Do NOT import the historical flash database into RAM. Its content
    # is exactly the client-MAC history this service exists to discard.
    # gl_clients recreates client.db when needed.
    if [ -f "$CLIENT_DB" ]; then
        # Just rm — shred is theatre on NAND (wear leveling + FTL
        # indirection mean overwrites land in new cells while the old
        # ones remain readable via chip-off), so it only creates a
        # false sense of security. See AGENTS.md for the policy.
        rm -f "$CLIENT_DB"
    fi

    rc=0
    if ! mount -t tmpfs -o mode=0755,size=1M tmpfs "$CLIENT_DB_DIR"; then
        logger -p err -t blue-merle "Failed to mount tmpfs on $CLIENT_DB_DIR"
        rc=1
    elif ! awk -v p="$CLIENT_DB_DIR" '$2 == p && $3 == "tmpfs" { found=1 } END { exit !found }' /proc/mounts; then
        logger -p err -t blue-merle "$CLIENT_DB_DIR is not backed by tmpfs after mount"
        rc=1
    fi

    # Restart gl_clients on every outcome: a failed take-over must not
    # leave the stock client-tracking daemon down.
    if [ -n "$gl_clients_was_running" ]; then
        /etc/init.d/gl_clients start 2>/dev/null || true
        logger -p notice -t blue-merle "volatile-client-macs: gl_clients restarted (mount rc=$rc)"
    fi

    return $rc
}

stop() {
    # Mirror of the start() guard: gl_clients must not hold the db open
    # across the umount — it would keep an fd to the hidden tmpfs
    # inode, and its next start would silently recreate the db on
    # flash. Stop it first, restart it after (never leave the stock
    # daemon down). In the package prerm ordering gl_clients is already
    # stopped here, so this is a no-op there.
    gl_clients_was_running=""
    if pidof gl_clients >/dev/null 2>&1; then
        gl_clients_was_running=1
        /etc/init.d/gl_clients stop 2>/dev/null || true
        logger -p notice -t blue-merle "volatile-client-macs: stopped gl_clients before umount of $CLIENT_DB_DIR"
    fi

    # We are being explicitly stopped (uninstall or reload). Truncate
    # the in-RAM db and unmount. `rm` is the right primitive on tmpfs;
    # `shred` is meaningless on RAM-backed filesystems.
    if grep -q " ${CLIENT_DB_DIR} " /proc/mounts; then
        rm -f "$CLIENT_DB"
        umount "$CLIENT_DB_DIR" 2>/dev/null || umount -l "$CLIENT_DB_DIR" 2>/dev/null
    fi

    if [ -n "$gl_clients_was_running" ]; then
        /etc/init.d/gl_clients start 2>/dev/null || true
        logger -p notice -t blue-merle "volatile-client-macs: gl_clients restarted after umount"
    fi
}
